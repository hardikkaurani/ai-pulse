# AI Pulse Environment Configuration Example

# Backend Settings
SECRET_KEY=ai-pulse-production-secret-key-change-in-prod
DATABASE_URL=sqlite:///./aipulse.db
TOKEN_HOURS=12

# AI Engine Mode ("mock" for deterministic local evaluation, "live" for real OpenAI/Gemini compatible API)
AI_MODE=mock
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# CORS Allowed Origins (comma-separated, or * for open development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Settings (passed at build time or runtime)
VITE_API_URL=http://localhost:8000
